    {
      "_meta": {
        "fastmcp": {
          "tags": []
        }
      },
      "annotations": {
        "openWorldHint": true,
        "readOnlyHint": true
      },
      "description": "Decide whether and how to query a dataset: columns, live row count, data_coverage\n(actual time range), place fields for \"in <area>\" questions (with reliability),\nand geo columns for `near`.\n\nCall before querying a dataset whose columns you do not know.\nFor area questions, use detail=\"full\".\nFilter a place field on its `value`, never its label; an area may span several values.\nIllustrative example: {\"portal\": \"example-city\", \"dataset_id\": \"abcd-1234\", \"detail\": \"full\"}.\nWith column_cursor, send only portal, dataset_id, column_query, detail, column_cursor.\nTypically 1-3 s; fails with query_timeout after 30 s.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "column_cursor": {
            "description": "next_column_cursor from the previous page; omit for page one.",
            "minLength": 1,
            "type": "string"
          },
          "column_query": {
            "description": "Only columns whose name or description contains this; omit for all.",
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "dataset_id": {
            "description": "Socrata dataset id, e.g. abcd-1234 (from atlas_search_datasets).",
            "pattern": "^[a-z0-9]{4}-[a-z0-9]{4}$",
            "type": "string"
          },
          "detail": {
            "description": "summary (default) or full: adds place-field values and column stats.",
            "enum": [
              "summary",
              "full"
            ],
            "type": "string"
          },
          "portal": {
            "description": "Portal id (its hostname) or alias, from atlas_find_portals. Repeat it on every page of a paged call.",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]{1,99}$",
            "type": "string"
          },
          "sample_rows": {
            "description": "Example rows to include. Default 0.",
            "maximum": 5,
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "portal",
          "dataset_id"
        ],
        "type": "object"
      },
