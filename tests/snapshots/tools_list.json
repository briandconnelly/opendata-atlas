          "external_matches": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "asset_type": {
                  "type": "string"
                },
                "category": {
                  "type": "string"
                },
                "dataset_id": {
                  "type": "string"
                },
                "derived_from": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "external_url": {
                  "type": "string"
                },
