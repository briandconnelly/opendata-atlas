      "annotations": {
        "openWorldHint": true,
        "readOnlyHint": true
      },
      "description": "Find a portal's datasets by topic. Call when you lack a dataset id.\n\nResults are candidates: match_evidence lists the query words each one's metadata\nlacks. Only queryability \"supported\" can be described or queried; a tabular search\nalso returns up to 3 external_matches, which cannot.\nIllustrative example: {\"portal\": \"example-city\", \"query\": \"fire 911\"}. Typically 1-3 s.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "asset_scope": {
            "description": "tabular (default): queryable datasets and filter views. all: adds federated ArcGIS and external links, which cannot be queried.",
            "enum": [
              "tabular",
              "all"
            ],
            "type": "string"
          },
          "category": {
            "description": "Exact category name, e.g. Public Safety; omit for all.",
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "cursor": {
            "description": "next_cursor from the previous page; omit for page one.",
            "minLength": 1,
            "type": "string"
          },
          "detail": {
            "description": "summary (default) or full: adds descriptions.",
            "enum": [
              "summary",
              "full"
            ],
            "type": "string"
          },
          "page_size": {
            "description": "Default 10.",
            "maximum": 50,
            "minimum": 1,
            "type": "integer"
          },
          "portal": {
            "description": "Portal id (its hostname) or alias, from atlas_find_portals. Repeat it on every page of a paged call.",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]{1,99}$",
            "type": "string"
          },
          "query": {
            "description": "Words to match; omit to list the most-viewed.",
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "portal"
        ],
        "type": "object"
      },
