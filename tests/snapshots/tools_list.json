      "annotations": {
        "openWorldHint": true,
        "readOnlyHint": true
      },
      "description": "Run a bounded read or aggregate on one dataset; paging stops at 10,000 rows.\n\nFor counts and breakdowns, use count(*) with group_by, not row paging.\nWith cursor, send only portal, dataset_id, cursor, and optionally page_size or detail.\nFor all rows, give the user download_url (detail=\"full\") instead of paging.\nIllustrative example: {\"portal\": \"example-city\", \"dataset_id\": \"abcd-1234\",\n\"select\": [\"type\", \"count(*) AS n\"], \"group_by\": [\"type\"], \"order_by\": [\"n DESC\"]}.\nTypically 1-5 s; fails with query_timeout after 30 s.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "cursor": {
            "description": "next_cursor from the previous page; omit for page one.",
            "minLength": 1,
            "type": "string"
          },
          "dataset_id": {
            "description": "Socrata dataset id, e.g. abcd-1234 (from atlas_search_datasets).",
            "pattern": "^[a-z0-9]{4}-[a-z0-9]{4}$",
            "type": "string"
          },
          "detail": {
            "description": "summary (default) or full: adds query_url and download_url (CSV of all matching rows).",
            "enum": [
              "summary",
              "full"
            ],
            "type": "string"
          },
          "group_by": {
            "description": "e.g. [\"type\"]; omit for no grouping.",
            "items": {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "having": {
            "description": "Predicate on aggregated rows, e.g. \"n > 10\"; omit for none.",
            "maxLength": 4096,
            "minLength": 1,
            "type": "string"
          },
          "mode": {
            "description": "clauses (default): built from the clause arguments, paged by cursor. soql: run `soql` verbatim, one page.",
            "enum": [
              "clauses",
              "soql"
            ],
            "type": "string"
          },
          "near": {
            "additionalProperties": false,
            "description": "Rows within radius_m meters of a point; omit for no distance filter.",
            "properties": {
              "column": {
                "description": "A column listed in describe's geo_columns.",
                "minLength": 1,
                "type": "string"
              },
              "latitude": {
                "maximum": 90,
                "minimum": -90,
                "type": "number"
              },
              "longitude": {
                "maximum": 180,
                "minimum": -180,
                "type": "number"
              },
              "radius_m": {
                "description": "Radius in meters.",
                "exclusiveMinimum": 0,
                "maximum": 50000,
                "type": "number"
              }
            },
            "required": [
              "column",
              "latitude",
              "longitude",
              "radius_m"
            ],
            "type": "object"
          },
          "order_by": {
            "description": "e.g. [\"n DESC\"]; omit for arbitrary order. DESC lists nulls first: for most recent, add `col IS NOT NULL` to where.",
            "items": {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "page_size": {
            "description": "Most rows to return (default 100; wide rows may return fewer). Omit on a continuation to keep the first page's size.",
            "maximum": 500,
            "minimum": 1,
            "type": "integer"
          },
          "portal": {
            "description": "Portal id (its hostname) or alias, from atlas_find_portals. Repeat it on every page of a paged call.",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]{1,99}$",
            "type": "string"
          },
          "search_text": {
            "description": "Full-text search across text columns; omit for none.",
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "select": {
            "description": "Columns or expressions, e.g. [\"type\", \"count(*) AS n\"]. Omit for all data columns.",
            "items": {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "soql": {
            "description": "Full SoQL statement; set mode='soql' and no clause arguments. Not paged: use LIMIT <= page_size and advance OFFSET.",
            "maxLength": 4096,
            "minLength": 1,
            "type": "string"
          },
          "where": {
            "description": "SoQL predicate, e.g. \"datetime >= '2026-09-01T00:00:00'\". Never append Z or call now(); both fail. Omit for all rows.",
            "maxLength": 4096,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "portal",
          "dataset_id"
        ],
        "type": "object"
      },
      "name": "atlas_query_dataset",
      "outputSchema": {
        "additionalProperties": true,
        "properties": {
          "columns": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
