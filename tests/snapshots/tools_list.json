  "tools": [
    {
      "_meta": {
        "fastmcp": {
          "tags": []
        }
      },
      "annotations": {
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "Find portals by place name; the portal id it returns goes in every other tool's `portal`.\n\nCall this before any tool that takes `portal` when you lack its id.\nIt never picks a portal for you: an ambiguous place returns every candidate, told apart\nby jurisdiction.level (a city portal and its county portal can both match).\nWhen candidates differ in jurisdiction.level, ask the user which they mean, unless the\nrequest already says.\nCandidates are ordered by match (alias, name, place_name, host), then tier, then id.\nNo match is an empty candidates list, not an error.\nWith cursor, send only cursor and optionally page_size.\nExample: {\"query\": \"Chicago\"}. Reads the shipped registry; no network call.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "country": {
            "description": "ISO 3166-1 alpha-2 country code, e.g. US (any case); omit for all.",
            "pattern": "^[A-Za-z]{2}$",
            "type": "string"
          },
          "cursor": {
            "description": "next_cursor from the previous page; omit for page one.",
            "minLength": 1,
            "type": "string"
          },
          "level": {
            "description": "Only portals of this jurisdiction level; omit for all.",
            "enum": [
              "city",
              "county",
              "region",
              "state",
              "national",
              "other"
            ],
            "type": "string"
          },
          "page_size": {
            "description": "Default 10.",
            "maximum": 50,
            "minimum": 1,
            "type": "integer"
          },
          "query": {
            "description": "Place, portal name, alias or host label, e.g. Chicago. Every word must appear in one name; drop extra words if nothing matches. Omit, with no other argument, to page through every portal, curated first.",
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "tier": {
            "description": "Only portals of this tier; omit for all tiers.",
            "enum": [
              "generic",
              "profiled",
              "curated"
            ],
            "type": "string"
          }
        },
        "type": "object"
      },
      "name": "atlas_find_portals",
      "outputSchema": {
        "additionalProperties": true,
        "properties": {
          "candidates": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "aliases": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "dataset_count": {
                  "type": "integer"
                },
                "id": {
                  "type": "string"
                },
                "jurisdiction": {
                  "additionalProperties": false,
                  "properties": {
                    "country": {
                      "type": "string"
                    },
                    "level": {
                      "enum": [
                        "city",
                        "county",
                        "region",
                        "state",
                        "national",
                        "other"
                      ]
                    },
                    "region": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "level",
                    "country"
                  ],
                  "type": "object"
                },
                "match": {
                  "enum": [
                    "alias",
                    "name",
                    "place_name",
                    "host"
                  ]
                },
                "name": {
                  "type": "string"
                },
                "tier": {
                  "enum": [
                    "generic",
                    "profiled",
                    "curated"
                  ]
                },
                "timezone": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "aliases",
                "name",
                "tier"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "has_more": {
            "type": "boolean"
          },
          "next_cursor": {
            "type": "string"
          },
          "registry_version": {
            "type": "string"
          },
          "source": {
            "additionalProperties": false,
            "properties": {
              "now_local": {
                "type": "string"
              },
              "now_local_reason": {
                "enum": [
                  "multi_zone",
                  "unknown"
                ]
              },
              "now_weekday": {
                "type": "string"
              },
              "portal": {
                "additionalProperties": false,
                "properties": {
                  "alias": {
                    "type": "string"
                  },
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "tier": {
                    "enum": [
                      "generic",
                      "profiled",
                      "curated"
                    ]
                  },
                  "timezone": {
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "name",
                  "tier"
                ],
                "type": "object"
              },
              "request_id": {
                "type": "string"
              },
              "retrieved_at": {
                "type": "string"
              }
            },
            "required": [
              "request_id"
            ],
            "type": "object"
          }
        },
        "required": [
          "candidates",
          "has_more",
          "registry_version",
          "source"
        ],
        "type": "object"
      },
      "title": "Atlas Find Portals"
    },
    {
      "_meta": {
        "fastmcp": {
