              "required": [
                "column",
                "reliability",
                "reason"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "dataset_id": {
            "type": "string"
          },
          "download_url": {
            "type": "string"
          },
          "download_url_omitted": {
            "type": "boolean"
          },
          "effective_query": {
            "type": "string"
          },
          "has_more": {
            "type": "boolean"
          },
          "hints": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "alternative": {
                  "type": "string"
                },
                "arguments": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "next_step": {
                  "type": "string"
                },
                "tool": {
                  "type": "string"
                }
              },
              "required": [
                "next_step",
                "tool",
                "arguments"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "knowledge_notice": {
            "additionalProperties": false,
            "description": "What this result relies on that no reviewed claim covers; level is the dataset's.",
            "properties": {
              "level": {
                "enum": [
                  "none",
                  "profiled",
                  "reviewed"
                ]
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "level",
              "message"
            ],
            "type": "object"
          },
          "next_cursor": {
            "type": "string"
          },
          "query_url": {
            "type": "string"
          },
          "query_url_omitted": {
            "type": "boolean"
          },
          "returned_rows": {
            "type": "integer"
          },
          "rows": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array"
          },
          "source": {
            "additionalProperties": false,
            "properties": {
              "now_local": {
                "type": "string"
              },
              "now_local_reason": {
                "enum": [
                  "multi_zone",
                  "unknown"
                ]
              },
              "now_weekday": {
                "type": "string"
              },
              "portal": {
                "additionalProperties": false,
                "properties": {
                  "alias": {
                    "type": "string"
                  },
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "tier": {
                    "enum": [
                      "generic",
                      "profiled",
                      "curated"
                    ]
                  },
                  "timezone": {
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "name",
                  "tier"
                ],
                "type": "object"
              },
              "request_id": {
                "type": "string"
              },
              "retrieved_at": {
                "type": "string"
              }
            },
            "required": [
              "request_id"
            ],
            "type": "object"
          },
          "truncated": {
            "type": "boolean"
          },
          "truncation_hint": {
            "type": "string"
          },
          "truncation_reason": {
            "type": "string"
          }
        },
        "required": [
          "dataset_id",
          "columns",
          "rows",
          "returned_rows",
          "has_more",
          "truncated",
          "consistency",
          "source"
        ],
        "type": "object"
      },
      "title": "Atlas Query Dataset"
